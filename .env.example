# ==============================================================================
# ENVIRONMENT CONFIGURATION - ENTERPRISE APARTMENT MANAGEMENT SAAS PLATFORM
# ==============================================================================

# Database Connection URL
# For local SQLite zero-config development:
DATABASE_URL="file:./dev.db"

# For PostgreSQL production deployment (e.g., Supabase / Neon / AWS RDS / Self-hosted):
# DATABASE_URL="postgresql://postgres:YourSecureDatabasePassword2026!@localhost:5432/apartment_management_db?schema=public"

# JSON Web Token Secret for Session Authentication & Role Authorization
JWT_SECRET="super-secret-jwt-token-apartment-management-saas-2026"

# QR Attendance HMAC Cryptographic Signing Secret (Used for 60-second rotating QR gate passes)
QR_HMAC_SECRET="dev_qr_attendance_super_secret_signing_key_2026"

# Application Metadata
NEXT_PUBLIC_APP_NAME="PalmHeights Living"
NEXT_PUBLIC_APP_TAGLINE="Premium Apartment Management & Community Services Marketplace"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Upload Directory (Public Static Route)
NEXT_PUBLIC_UPLOAD_DIR="/uploads/campaigns"
